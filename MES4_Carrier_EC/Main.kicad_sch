		(effects (font (size 2 2) (bold yes)) (justify left top))
		(uuid "2c91ad1b-1855-5a53-8372-71a5d089f37b")
	)
	(text "Pulls NRST low only.\nNo capacitor: C6 100 nF\nis on the module (CIF §4a)."
		(exclude_from_sim no)
		(at 271.78 80.01 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "37b7516f-3d3c-5617-98d9-940f3fbcffa3")
	)
