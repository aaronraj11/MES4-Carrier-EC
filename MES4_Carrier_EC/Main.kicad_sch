	(text "LED1 red  = module +5V present (3 mA).\nLED2 green = module 3V3 present\n(fed from finger 4, ~0.7 mA)."
		(exclude_from_sim no)
		(at 165.1 80.01 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "87594b39-6cbd-5a5a-809e-9fcbc4bd40e1")
	)
	(text "I²C1 + ALERT pull-ups"
		(exclude_from_sim no)
		(at 223.52 22.86 0)
		(effects (font (size 2 2) (bold yes)) (justify left top))
		(uuid "f4f70a78-0fca-51d8-a0a9-c78b78ad79be")
	)
	(text "CIF rule 7: always fitted,\nto the module's 3V3 (finger 4).\n2.2k: 4 × INA226 at 400 kHz.\nR5: INA226 ALERT wire-OR (PA15)."
		(exclude_from_sim no)
		(at 223.52 80.01 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "ebd24346-6b60-5e89-8f07-f437f234df56")
	)
