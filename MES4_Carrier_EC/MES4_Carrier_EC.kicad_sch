	(text "Own L pi filter from +24V.\nU9 URB2409S-10WR3 → 9 V →\nSW2 switch → J14 IMU terminal\n(as on the MES3.1 carrier).\nU10 URB2405LD-20WR3 → 5 V 4 A\n→ 3 A PTC → J16 USB-C (Rp 10k:\n5 V / 3 A) → ARZOPA Z1C screen.\nDoor servo (FE-URT-2): J15 24 V\n+ J17 UART (USART2)."
		(exclude_from_sim no)
		(at 312.42 149.86 0)
		(effects (font (size 1.8 1.8)) (justify left top))
		(uuid "bba7df27-e767-5566-af3c-21099838d533")
