		(uuid "c9d31cc3-1c0f-5d5f-8d21-0ddbc237197a")
	)
	(text "4-wire bridge, excited from +5V\n(ratiometric, as on the MES4-Flasher).\n100 Ω / 100 nF / 10 nF filters,\nBAV199 clamps. 24 bit, gain 128,\n10 SPS.\nDRDY PA4, SCLK PA5, PDWN PA6."
		(exclude_from_sim no)
		(at 208.28 165.1 0)
		(effects (font (size 1.8 1.8)) (justify left top))
		(uuid "4ee65035-e8b0-5d09-b89b-13761ca63f14")
	)
