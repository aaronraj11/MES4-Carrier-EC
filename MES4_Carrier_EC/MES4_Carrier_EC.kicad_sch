	(text "MES4-MCU module (J1, M.2 socket)"
		(exclude_from_sim no)
		(at 109.22 42.93 0)
		(effects (font (size 2.2 2.2) (bold yes)) (justify left top))
		(uuid "2164847f-0ff2-5467-adbd-c84d0b2cd26b")
	)
	(text "STM32G0B1, 64 MHz, CAN transceiver.\nGets +5V on fingers 20 / 22.\nMakes its own 3.3 V → +3V3_MOD\n(finger 4, ≤ 50 mA) for the I²C\npull-ups, INA226s, PC817 outputs\nand the ADS1232 logic.\n\nAll 14 GPIOs are used\n(GPIO map on the Main sheet).\n\nLED1 = module +5V, LED2 = 3V3.\nHold-down: H1 M3 standoff.\n\nNo hot-plug: unplug the XT30\nbefore fitting a module."
		(exclude_from_sim no)
		(at 109.22 48.26 0)
		(effects (font (size 1.8 1.8)) (justify left top))
		(uuid "796375a7-5b03-54d7-a20e-9bc2b35bea36")
	)
	(rectangle
		(start 205.74 40.64)
		(end 297.18 106.68)
		(stroke (width 0.5) (type solid) (color 200 30 30 1))
		(fill (type color) (color 222 242 222 1))
		(uuid "de7e1242-9f81-5af1-82c8-9db6e8033039")
	)
	(text "4 relay outputs (CIF §7)"
		(exclude_from_sim no)
		(at 208.28 42.93 0)
		(effects (font (size 2.2 2.2) (bold yes)) (justify left top))
		(uuid "2d71ff8e-5a2b-538a-9485-639021823675")
	)
	(text "1 safety light: PA8 drive, INA226 0x40\n2 LED DRL: PC6 drive, INA226 0x41\n3 battery stopper: PB3 drive, INA226 0x44\n4 spare: PA7 drive, INA226 0x45\n\nGPIO → 100 Ω → AO3400A → 5 V coil\n(SRD-5VDC-SL-A, on +5V_24).\n+24V → 30 mΩ shunt → contact →\n3A PTC → output (2 A continuous).\nNo coil feedback (pins used elsewhere).\nINA226 per channel: load current +\n24 V rail, ALERT → PA15."
		(exclude_from_sim no)
		(at 208.28 48.26 0)
		(effects (font (size 1.8 1.8)) (justify left top))
		(uuid "23c74c82-eb1c-5339-80b9-a799b43773c7")
	)
	(rectangle
		(start 205.74 116.84)
		(end 297.18 147.32)
		(stroke (width 0.5) (type solid) (color 200 30 30 1))
		(fill (type color) (color 222 242 222 1))
		(uuid "18e22fcc-f052-58b9-9e3d-8df554a50a1a")
	)
	(text "2 Autonics sensor inputs"
		(exclude_from_sim no)
		(at 208.28 119.13 0)
		(effects (font (size 2.2 2.2) (bold yes)) (justify left top))
		(uuid "21e9a386-dbcc-5909-800a-f41269bebe05")
	)
	(text "+24V → 100 mA PTC → sensor supply.\nSensor OUT → 10k → PC817 → PB6 / PC15\n(HIGH = sensor ON). PNP 24 V sensors."
		(exclude_from_sim no)
		(at 208.28 124.46 0)
		(effects (font (size 1.8 1.8)) (justify left top))
		(uuid "b5b710ba-7d74-5ed8-a632-6d245818e09c")
	)
	(rectangle
