	(text "First power-up"
		(exclude_from_sim no)
		(at 208.28 190.5 0)
		(effects (font (size 2 2) (bold yes)) (justify left top))
		(uuid "692c38fe-c572-5b69-9eed-df447b5e68e6")
	)
	(text "1. No module fitted. Apply 24 V on J5 from a current-limited supply: LED3 lights;\n   +24V, +24V_DC, +5V_24 and +5V present (LED1 on).\n2. Reverse the lead briefly: nothing lights and +24V stays at 0 V (Q1 blocks).\n3. Unplug 24 V, fit the module, plug in again: LED2 lights (module 3V3).\n   Then flash over STDC14 (J2)."
		(exclude_from_sim no)
		(at 208.28 195.58 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "27211ae6-300d-53e2-a051-71826fbbb321")
	)
